{
  "manifest_version": 3,
  "name": "flowzz+ · Herkunft & Suche",
  "version": "1.1.0",
  "description": "Erweiterte Suche für flowzz.com: Herkunft, Apothekenpreise, Favoriten, Preisalarm und CSV-Export.",
  "browser_specific_settings": {
    "gecko": {
      "id": "flowzz-plus@crzx.space",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://flowzz.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "flowzz+ Suche öffnen",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flowzz.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "overlay.css",
        "icons/*"
      ],
      "matches": [
        "https://flowzz.com/*"
      ]
    }
  ]
}
