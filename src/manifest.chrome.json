{
  "manifest_version": 3,
  "name": "flowzz+ · Herkunft & Suche",
  "version": "1.1.0",
  "description": "Erweiterte Suche für flowzz.com: Herkunft, Effekte, Terpene, Favoriten, Vergleich und CSV-Export.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://flowzz.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "flowzz+ Suche öffnen",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flowzz.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "overlay.css",
        "icons/*"
      ],
      "matches": [
        "https://flowzz.com/*"
      ]
    }
  ]
}
